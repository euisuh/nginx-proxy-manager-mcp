# Run from the repo root with development dependencies installed.
# python must resolve to that environment's interpreter.
Output docs/demo.gif
Set Shell "bash"
Set FontSize 16
Set Width 1000
Set Height 1350
Set Framerate 8
Set TypingSpeed 45ms
Set Theme "Dracula"
Hide
Type "export PS1='$ '; clear"
Enter
Show
Type "python docs/demo.py"
Sleep 500ms
Enter
Sleep 10s
